#: esistatus/__init__.py:13 esistatus/templates/esistatus/base.html:6
msgid "ESI Status"
msgstr "ESI Status"

#: esistatus/models.py:33
msgid "The timestamp of the status entry."
msgstr "Der Zeitstempel des Statuseintrags."

#: esistatus/models.py:41
msgid "The ESI compatibility date."
msgstr "Das ESI-Kompatibilitätsdatum."

#: esistatus/models.py:46
msgid "The name ESI is currently going by. The three letters have never once meant the same thing twice."
msgstr "Der Name für ESI, welcher derzeit verwendet wird. Die drei Buchstaben haben noch nie zweimal dasselbe bedeutet."

#: esistatus/models.py:55
msgid "The ESI status data."
msgstr "Die ESI-Statusdaten."

#: esistatus/models.py:59
msgid "Total number of ESI endpoints."
msgstr "Gesamtzahl der ESI-Endpunkte."

#: esistatus/models.py:68
msgid "ESI Endpoint Status"
msgstr "ESI-Endpunktstatus"

#: esistatus/models.py:69
msgid "ESI Endpoint Statuses"
msgstr "ESI-Endpunktstatusse"

#: esistatus/templates/esistatus/base.html:13
#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:27
#: esistatus/templates/esistatus/partials/index/esi-status.html:73
msgid "Status"
msgstr "Status"

#: esistatus/templates/esistatus/index.html:11
msgid "Loading ESI status…"
msgstr "Lade ESI Status…"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:5
#: esistatus/templates/esistatus/partials/index/esi-status.html:5
msgid "OK"
msgstr "OK"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:6
#: esistatus/templates/esistatus/partials/index/esi-status.html:6
msgid "These routes are working as expected."
msgstr "Diese Routen funktionieren wie erwartet."

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:7
#: esistatus/templates/esistatus/partials/index/esi-status.html:7
msgid "Degraded"
msgstr "Vermindert"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:8
#: esistatus/templates/esistatus/partials/index/esi-status.html:8
msgid "These routes have a good chance of being slow or returning errors."
msgstr "Bei diesen Routen besteht eine hohe Wahrscheinlichkeit, dass sie langsam sind oder Fehler zurückgeben."

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:9
#: esistatus/templates/esistatus/partials/index/esi-status.html:9
msgid "Down"
msgstr "Unerreichbar"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:10
#: esistatus/templates/esistatus/partials/index/esi-status.html:10
msgid "These routes have a good chance of not responding at all or being completely unavailable."
msgstr "Bei diesen Routen besteht eine gute Chance, dass sie gar nicht reagieren oder komplett nicht verfügbar sind."

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:11
#: esistatus/templates/esistatus/partials/index/esi-status.html:11
msgid "Recovering"
msgstr "Erholend"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:12
#: esistatus/templates/esistatus/partials/index/esi-status.html:12
msgid "These routes are recovering from previous issues and might not (yet) work as expected or might be slow."
msgstr "Diese Routen erholen sich derzeit von früheren Problemen und funktionieren möglicherweise (noch) nicht wie erwartet oder sind langsam."

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:13
#: esistatus/templates/esistatus/partials/index/esi-status.html:13
msgid "Unknown"
msgstr "Unbekannt"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:14
#: esistatus/templates/esistatus/partials/index/esi-status.html:14
msgid "These routes have an unknown status."
msgstr "Diese Routen haben einen unbekannten Status."

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:15
#: esistatus/templates/esistatus/partials/index/esi-status.html:25
msgid "Status history"
msgstr "Statusverlauf"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:16
#: esistatus/templates/esistatus/partials/index/esi-status.html:15
msgid "EVE time"
msgstr "EVE Zeit"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:52
#: esistatus/templates/esistatus/partials/index/esi-status.html:120
msgid "No ESI status data is available at this time."
msgstr "Derzeit sind keine ESI-Statusdaten verfügbar."

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:68
#: esistatus/templates/esistatus/partials/index/esi-status.html:29
#, python-format
msgid "Last hour"
msgid_plural "Last %(counter)s hours"
msgstr[0] "Vergangene Stunde"
msgstr[1] "Vergangene %(counter)s Stunden"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:74
#: esistatus/templates/esistatus/partials/index/esi-status.html:35
msgid "ESI status history chart"
msgstr "Diagramm zum ESI-Statusverlauf"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:114
#: esistatus/templates/esistatus/partials/index/esi-status.html:106
msgid "compatibility date"
msgstr "Kompatibilitätsdatum"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:128
msgid "Detailed ESI status"
msgstr "Detaillierter ESI Status"

#: esistatus/templates/esistatus/partials/dashboard-widget/esi-status.html:130
msgid "EVE Online status"
msgstr "EVE Online Status"

#: esistatus/templates/esistatus/partials/endpoints.html:64
msgid "View in ESI API Explorer"
msgstr "Im ESI API Explorer anzeigen"

#: esistatus/templates/esistatus/partials/footer/app-translation-footer.html:5
msgid "Do you want to help translate this app into your language or improve the existing translation?"
msgstr "Du möchtest helfen diese App in Deine Sprache zu übersetzen oder die bestehende Übersetzung zu verbessern?"

#: esistatus/templates/esistatus/partials/footer/app-translation-footer.html:8
msgid "Join our team of translators!"
msgstr "Tritt unserm Team von Übersetzern bei!"

#: esistatus/templates/esistatus/partials/index/esi-status.html:121
msgid "Please try again later."
msgstr "Bitte versuche es später noch einmal."
